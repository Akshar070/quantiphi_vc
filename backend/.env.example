# Server Port
PORT=5000

# MongoDB Connection URI
# Local MongoDB default: mongodb://127.0.0.1:27017/ai_chat_assistant
# MongoDB Atlas example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/ai_chat_assistant?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/ai_chat_assistant

# Anthropic Claude API Key (Get from https://console.anthropic.com/)
# Note: Anthropic API requires prepaid credits on console.anthropic.com/settings/plans
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Claude Model: claude-3-5-sonnet-20241022 or claude-3-haiku-20240307
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# (Optional) Google Gemini API Key - Free tier available at https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=your_gemini_api_key_here
